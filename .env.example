# ResearchLink Environment Variables Template
# Copy this file to '.env' and populate with your own credentials.
# DO NOT COMMIT THE '.env' FILE TO GITHUB.

# Core Django Settings
DEBUG=True
SECRET_KEY=generate-a-long-random-string-here-for-production-security
ALLOWED_HOSTS=localhost,127.0.0.1,your-app-subdomain.onrender.com

# Database Configuration (MySQL)
DB_NAME=researchlink
DB_USER=researchlink_user
DB_PASS=researchlink_pass
DB_HOST=127.0.0.1
DB_PORT=3306
